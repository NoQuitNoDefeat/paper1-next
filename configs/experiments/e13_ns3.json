{
 "name": "E13 ns-3 复核：群集 30 主条件（PHY 执行加帧内运动）",
 "out": "results/e13/ns3",
 "eval": {
  "split": "test",
  "seed_offset": 5000,
  "episodes": 16,
  "drain": 1000,
  "shards": 4
 },
 "executors": {
  "lightweight": null,
  "ns3": "ns3"
 },
 "scenarios": {
  "fold_4mps": {
   "scenario": "configs/datasets/flock30.toml",
   "set": [
    "scenario.train=[\"6mps_circular\", \"8mps_circular\"]",
    "scenario.test=[\"4mps_diagonal\"]",
    "scenario.radio.tx_power_dbm=10.31",
    "backend.channel={type=\"rician\", k_factor_db=10.0}"
   ]
  },
  "fold_6mps": {
   "scenario": "configs/datasets/flock30.toml",
   "set": [
    "scenario.train=[\"4mps_diagonal\", \"8mps_circular\"]",
    "scenario.test=[\"6mps_circular\"]",
    "scenario.radio.tx_power_dbm=10.31",
    "backend.channel={type=\"rician\", k_factor_db=10.0}"
   ]
  },
  "fold_8mps": {
   "scenario": "configs/datasets/flock30.toml",
   "set": [
    "scenario.train=[\"4mps_diagonal\", \"6mps_circular\"]",
    "scenario.test=[\"8mps_circular\"]",
    "scenario.radio.tx_power_dbm=10.31",
    "backend.channel={type=\"rician\", k_factor_db=10.0}"
   ]
  }
 },
 "baseline_config": "configs/protocol_final.toml",
 "baselines": [
  "longest_queue"
 ],
 "groups": {
  "主方法": [
   "results/e6/no_set_summary-s0",
   "results/e6/no_set_summary-s1",
   "results/e6/no_set_summary-s2",
   "results/e9/final-s3",
   "results/e9/final-s4"
  ]
 }
}
