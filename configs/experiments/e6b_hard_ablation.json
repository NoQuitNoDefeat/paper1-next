{
  "name": "E6b 困难场景消融（冻结协议，排空 1000 周期）",
  "out": "results/e6b/confirm",
  "eval": {
    "split": "dev",
    "seed_offset": 16,
    "episodes": 32,
    "drain": 1000,
    "threads": 3
  },
  "baseline_config": "configs/protocol_a20.toml",
  "baselines": [
    "longest_queue",
    "hol_weighted"
  ],
  "fixed": {},
  "groups": {
    "完整模型": [
      "results/e5/A-lv20-s0",
      "results/e5/A-lv20-s1",
      "results/e5/A-lv20-s2"
    ],
    "去掉交互图": [
      "results/e6/no_interaction_graph-s0",
      "results/e6/no_interaction_graph-s1",
      "results/e6/no_interaction_graph-s2"
    ],
    "去掉已选摘要": [
      "results/e6/no_set_summary-s0",
      "results/e6/no_set_summary-s1",
      "results/e6/no_set_summary-s2"
    ],
    "去掉通信图消息传递": [
      "results/e6/no_comm_mp-s0",
      "results/e6/no_comm_mp-s1",
      "results/e6/no_comm_mp-s2"
    ],
    "去掉直接链路通路": [
      "results/e6/no_direct_link-s0",
      "results/e6/no_direct_link-s1",
      "results/e6/no_direct_link-s2"
    ],
    "两两相容约束（对照）": [
      "results/e6/pairwise_constraint-s0",
      "results/e6/pairwise_constraint-s1",
      "results/e6/pairwise_constraint-s2"
    ]
  },
  "variants": {
    "nodes24_dense": [
      "scenario.num_nodes=24"
    ],
    "nodes24_same_density": [
      "scenario.num_nodes=24",
      "scenario.area_m=367.4"
    ],
    "load_high": [
      "scenario.flow_rate_pps=[30.0, 45.0]"
    ],
    "channel_noisy": [
      "backend.channel.type=\"lognormal\""
    ]
  },
  "compare": [
    "longest_queue",
    "完整模型"
  ]
}
