    "nodes24_same_density": [
      "scenario.num_nodes=24",
      "scenario.area_m=367.4"
    ],
    "load_high": [
      "scenario.flow_rate_pps=[30.0, 45.0]"
    ],
    "channel_noisy": [
      "backend.channel.type=\"lognormal\""
    ]
  },
  "compare": [
    "longest_queue",
