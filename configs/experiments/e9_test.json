      "results/e8/summary_controller_dyn-s1",
      "results/e8/summary_controller_dyn-s2"
    ],
    "纯PPO（从零训练）": [
      "results/runs/base-lv5-s0",
      "results/runs/base-lv5-s1",
      "results/runs/base-lv5-s2"
    ]
  },
  "variants": {
