{
 "name": "E15 阴影强度：σ = 3、7 dB 与 σ = 5 dB 加 K = 5 dB（默认场景族前 32 个场景）",
 "out": "results/e15/sigma",
 "main": "主方法",
 "eval": {
  "split": "test",
  "seed_offset": 8000,
  "episodes": 32,
  "drain": 1000,
  "shards": 1
 },
 "executors": {
  "lightweight": null
 },
 "scenarios": {
  "c2s3_default": [
   "scenario.radio.pathloss_exponent=2.2",
   "scenario.radio.tx_power_dbm=13.379",
   "backend.channel={type=\"rician\", k_factor_db=10.0, shadowing_db=3.0}"
  ],
  "c2s7_default": [
   "scenario.radio.pathloss_exponent=2.2",
   "scenario.radio.tx_power_dbm=13.379",
   "backend.channel={type=\"rician\", k_factor_db=10.0, shadowing_db=7.0}"
  ],
  "c2s5k5_default": [
   "scenario.radio.pathloss_exponent=2.2",
   "scenario.radio.tx_power_dbm=13.379",
   "backend.channel={type=\"rician\", k_factor_db=5.0, shadowing_db=5.0}"
  ]
 },
 "baseline_config": "configs/protocol_final.toml",
 "baselines": [
  "longest_queue",
  "backpressure"
 ],
 "groups": {
  "主方法": [
   "results/e6/no_set_summary-s0",
   "results/e6/no_set_summary-s1",
   "results/e6/no_set_summary-s2",
   "results/e9/final-s3",
   "results/e9/final-s4"
  ],
  "Zhao-GCN": [
   "results/e11/runs/zhao_gcn-s0",
   "results/e11/runs/zhao_gcn-s1",
   "results/e11/runs/zhao_gcn-s2"
  ]
 }
}
