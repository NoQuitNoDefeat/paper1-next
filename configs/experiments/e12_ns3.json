{
 "name": "E12 ns-3 复核：C2 实测参数信道（PHY 执行加帧内运动，私有执行帧）",
 "out": "results/e12/ns3",
 "eval": {
  "split": "test",
  "seed_offset": 4000,
  "episodes": 32,
  "drain": 1000,
  "shards": 4
 },
 "executors": {
  "lightweight": null,
  "ns3": "ns3"
 },
 "scenarios": {
  "c2_default": [
   "scenario.radio.pathloss_exponent=2.2",
   "scenario.radio.tx_power_dbm=13.379",
   "backend.channel={type=\"rician\", k_factor_db=10.0}"
  ]
 },
 "baseline_config": "configs/protocol_final.toml",
 "baselines": [
  "longest_queue"
 ],
 "groups": {
  "主方法": [
   "results/e6/no_set_summary-s0",
   "results/e6/no_set_summary-s1",
   "results/e6/no_set_summary-s2",
   "results/e9/final-s3",
   "results/e9/final-s4"
  ]
 }
}
