{
 "name": "E14 合成场景：原训练分布与宽训练分布（低速、紧凑），测试集新种子",
 "out": "results/e14/synthetic",
 "main": "主方法·宽",
 "eval": {
  "split": "test",
  "seed_offset": 7000,
  "episodes": 64,
  "drain": 1000,
  "shards": 1
 },
 "executors": {
  "lightweight": null
 },
 "scenarios": {
  "default": {
   "scenario": "configs/protocol_final.toml",
   "set": []
  },
  "speed_0_5": {
   "scenario": "configs/protocol_final.toml",
   "set": [
    "scenario.speed_mps=[0.0, 5.0]"
   ]
  },
  "slow_compact": {
   "scenario": "configs/protocol_final.toml",
   "set": [
    "scenario.speed_mps=[0.0, 5.0]",
    "scenario.area_m=[150.0, 300.0]",
    "scenario.num_nodes=[16, 30]"
   ]
  },
  "nodes30_dense": {
   "scenario": "configs/protocol_final.toml",
   "set": [
    "scenario.num_nodes=30"
   ]
  }
 },
 "baseline_config": "configs/protocol_final.toml",
 "baselines": [
  "longest_queue",
  "backpressure"
 ],
 "fixed": {
  "仅模仿": "results/runs/imit-lq-bc-only/checkpoints/latest.pt"
 },
 "groups": {
  "主方法": [
   "results/e6/no_set_summary-s0",
   "results/e6/no_set_summary-s1",
   "results/e6/no_set_summary-s2",
   "results/e9/final-s3",
   "results/e9/final-s4"
  ],
  "主方法·宽": [
   "results/e14/runs/broad-main-s0",
   "results/e14/runs/broad-main-s1",
   "results/e14/runs/broad-main-s2",
   "results/e14/runs/broad-main-s3",
   "results/e14/runs/broad-main-s4"
  ],
  "Zhao-GCN": [
   "results/e11/runs/zhao_gcn-s0",
   "results/e11/runs/zhao_gcn-s1",
   "results/e11/runs/zhao_gcn-s2"
  ],
  "Zhao-GCN·宽": [
   "results/e14/runs/broad-zhao-s0",
   "results/e14/runs/broad-zhao-s1",
   "results/e14/runs/broad-zhao-s2"
  ],
  "GRLinQ": [
   "results/e11/runs/grlinq-s0",
   "results/e11/runs/grlinq-s1",
   "results/e11/runs/grlinq-s2"
  ],
  "GRLinQ·宽": [
   "results/e14/runs/broad-grlinq-s0",
   "results/e14/runs/broad-grlinq-s1",
   "results/e14/runs/broad-grlinq-s2"
  ],
  "独立决定PPO": [
   "results/e11/runs/oneshot_ppo-s0",
   "results/e11/runs/oneshot_ppo-s1",
   "results/e11/runs/oneshot_ppo-s2"
  ],
  "独立决定PPO·宽": [
   "results/e14/runs/broad-oneshot-s0",
   "results/e14/runs/broad-oneshot-s1",
   "results/e14/runs/broad-oneshot-s2"
  ],
  "仅模仿·宽": [
   "results/e14/runs/broad-imit-s0",
   "results/e14/runs/broad-imit-s1",
   "results/e14/runs/broad-imit-s2"
  ]
 }
}
